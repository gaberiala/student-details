public class Student {

    int id;
    String name;
    String department;
    int year;

    Student(int id, String name, String department, int year) {
        this.id = id;
        this.name = name;
        this.department = department;
        this.year = year;
    }

    void display() {
        System.out.println(
            id + " | " + name + " | " +
            department + " | " + year
        );
    }
}
